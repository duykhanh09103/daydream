  m_Name: greeting cutscene 1
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  dialogueName: 
  dialogueLines:
  - line: 'Gabriel: What do you plan on doing today?'
    hasChoices: 0
    choices: []
  - line: I'm getting materials from the library for a big project.
    hasChoices: 0
    choices: []
  - line: 'Gabriel: Oh! Mind sharing some details with me?'
    hasChoices: 0
    choices: []
  - line: "I\u2019m not too comfortable sharing\u2026"
    hasChoices: 0
    choices: []
  - line: "Gabriel: Are the teachers getting you into another top secret project
      thingy again? If so, I don\u2019t blame you for being quiet."
    hasChoices: 0
    choices: []
  - line: Something among the lines of that...
    hasChoices: 0
    choices:
    - choiceText: Keep going, you're making good prgress.
      jumpToLineInSameDialogue: 1
      targetLineIndex: 0
      nextDialogue: {fileID: 0}
  - line: 'Gabriel: I hope that I can join you in those projects one day. I still
      not as good as you yet...'
    hasChoices: 0
    choices: []
  - line: Keep going, you might even surpass me.
    hasChoices: 0
    choices: []
  - line: 'Gabriel: That''s nice of you to say.'
    hasChoices: 0
    choices: []
  - line: "Oh also, I got my hands on a new magic book recently. It\u2019s very old.
      But something about it feels ominous\u2026"
    hasChoices: 0
    choices: []
  - line: Be careful with it then. If you need anything, tell me.
    hasChoices: 0
    choices: []
  - line: 'Gabriel: Will do!'
    hasChoices: 0
    choices:
    - choiceText: Keep going, you're making good prgress.
      jumpToLineInSameDialogue: 1
      targetLineIndex: 0
      nextDialogue: {fileID: 0}
  - line: '???: Quite lively chatter here.'
    hasChoices: 0
    choices:
    - choiceText: Keep going, you're making good prgress.
      jumpToLineInSameDialogue: 1
      targetLineIndex: 0
      nextDialogue: {fileID: 0}
