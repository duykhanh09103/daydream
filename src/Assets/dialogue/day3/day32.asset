    hasChoices: 0
    choices: []
    conditions: []
  - line: "Voldem: Your regular magic is useless against the magic world\u2019s greatest
      threat!"
    hasChoices: 0
    choices: []
    conditions: []
  - line: "Servus: You are the source of that threat! Don\u2019t fool people into
      corrupting themselves for your own gain!"
    hasChoices: 0
    choices: []
    conditions: []
  - line: 'Voldem: Well then Yuri, who are you siding with?'
    hasChoices: 1
    choices:
    - choiceText: Side with your teacher.
